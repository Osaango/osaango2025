---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Icon from '../components/Icon.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';

const projects = (await getCollection('work'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const services = [
  { number: '01', title: 'Find the direction', text: 'Turn business ambition into a practical API, integration and platform strategy.' },
  { number: '02', title: 'Design the system', text: 'Shape scalable architecture, governance and ownership around real customer value.' },
  { number: '03', title: 'Make change flow', text: 'Give teams the operating model, methods and confidence to deliver continuously.' },
];
---

<BaseLayout isHome={true}>
  <main>
    <section class="hero-shell wrapper">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Strategy · Architecture · Change</p>
        <h1>Make complex change <em>flow.</em></h1>
        <p class="lead">We help organisations connect strategy, APIs, integrations and people—so ambitious digital change becomes clear, governable and ready to deliver.</p>
        <div class="actions">
          <CallToAction href="https://calendly.com/marjukka-niinioja/meet-with-marjukka">Start a conversation <Icon icon="arrow-right" /></CallToAction>
          <CallToAction href="/work/" variant="secondary">See our work</CallToAction>
        </div>
      </div>
      <div class="hero-system" aria-label="From strategy to customer value">
        <div class="route route-a"></div><div class="route route-b"></div>
        <span class="station s1"></span><span class="station s2"></span><span class="station s3"></span><span class="station s4"></span>
        <div class="system-card card-strategy"><small>START WITH</small><strong>Strategy</strong></div>
        <div class="system-card card-capability"><small>ORCHESTRATE</small><strong>Capabilities</strong></div>
        <div class="system-card card-value"><small>ARRIVE AT</small><strong>Customer value</strong></div>
        <img src="/design-system/humans/pose-with-scarf-pointing.svg" alt="APIOps character pointing toward a path to customer value" />
      </div>
    </section>

    <section class="signal-bar">
      <div class="wrapper signal-inner">
        <p>For leaders navigating</p>
        <ul><li>AI readiness</li><li>Platform strategy</li><li>Architecture renewal</li><li>API governance</li></ul>
      </div>
    </section>

    <section class="wrapper section-block approach">
      <div class="section-intro">
        <p class="eyebrow"><span></span> How we help</p>
        <h2>Clarity across the whole system.</h2>
        <p>Technology transformation works when business goals, architecture and ways of working move together. Osaango brings those perspectives into one shared view.</p>
      </div>
      <ol class="service-grid">
        {services.map((service) => <li><span>{service.number}</span><h3>{service.title}</h3><p>{service.text}</p></li>)}
      </ol>
    </section>

    <section class="dark-panel">
      <div class="wrapper dark-grid">
        <div>
          <p class="eyebrow light"><span></span> Our perspective</p>
          <h2>AI-ready starts long before the AI.</h2>
        </div>
        <div class="dark-copy">
          <p>Reliable AI-enabled products depend on reusable capabilities, well-designed APIs, intentional integration architecture and clear ownership.</p>
          <p>We connect those foundations—helping you move from isolated experiments to digital services that scale.</p>
          <a href="/about/">How we think <Icon icon="arrow-right" /></a>
        </div>
      </div>
    </section>

    <section class="wrapper section-block work-section">
      <div class="section-heading">
        <div><p class="eyebrow"><span></span> Selected work</p><h2>Change, made tangible.</h2></div>
        <a href="/work/">View all work <Icon icon="arrow-right" /></a>
      </div>
      <ul class="work-grid">{projects.map((project) => <li><PortfolioPreview project={project} /></li>)}</ul>
    </section>
  </main>
  <ContactCTA />
</BaseLayout>

<style>
  .hero-shell { display:grid; gap:3rem; min-height:clamp(42rem,78vh,54rem); align-items:center; padding-block:4rem 7rem; }
  .hero-copy { max-width:43rem; position:relative; z-index:2; }
  .eyebrow { display:flex; align-items:center; gap:.7rem; color:var(--apiops-accent-community); font-size:.76rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; margin-bottom:1.4rem; }
  .eyebrow span { width:2rem; height:3px; background:var(--color-cycle-capability); }
  h1 { font-size:clamp(3.6rem,8vw,7.2rem)!important; line-height:.91; letter-spacing:-.065em; max-width:9ch; }
  h1 em { color:var(--apiops-accent-community); font-style:normal; }
  .lead { max-width:39rem; margin-top:2rem; font-size:clamp(1.1rem,2vw,1.35rem); color:var(--color-neutral-stone); }
  .actions { display:flex; flex-wrap:wrap; gap:.8rem; margin-top:2rem; }
  .hero-system { min-height:29rem; position:relative; background:linear-gradient(145deg,#fff,#f6f9fe); border:1px solid var(--panel-border); border-radius:24px; overflow:hidden; box-shadow:var(--panel-shadow-soft); }
  .hero-system::before { content:''; position:absolute; inset:0; background-image:radial-gradient(#cbd5e1 1px,transparent 1px); background-size:22px 22px; opacity:.45; }
  .hero-system img { position:absolute; width:12rem; bottom:-.5rem; left:7%; z-index:2; }
  .route { position:absolute; height:8px; border-radius:9px; transform-origin:left center; }
  .route-a { width:76%; left:14%; top:62%; background:var(--color-line-operating-model); transform:rotate(-25deg); }
  .route-b { width:55%; left:42%; top:43%; background:var(--color-cycle-capability); transform:rotate(22deg); }
  .station { position:absolute; width:22px; height:22px; border:6px solid white; border-radius:50%; background:var(--color-line-operating-model); box-shadow:0 0 0 3px var(--color-line-operating-model); z-index:1; }
  .s1{left:15%;top:57%}.s2{left:43%;top:43%}.s3{left:66%;top:31%;background:var(--color-cycle-capability);box-shadow:0 0 0 3px var(--color-cycle-capability)}.s4{right:8%;top:51%;background:var(--color-cycle-capability);box-shadow:0 0 0 3px var(--color-cycle-capability)}
  .system-card { position:absolute; display:grid; gap:.15rem; background:#fff; border:1px solid var(--panel-border); border-radius:10px; padding:.75rem 1rem; box-shadow:var(--shadow-sm); z-index:3; }
  .system-card small{font-size:.58rem;letter-spacing:.1em;color:var(--muted);font-weight:800}.system-card strong{color:var(--foreground)}
  .card-strategy{left:7%;top:12%}.card-capability{left:44%;top:13%}.card-value{right:5%;bottom:11%}
  .signal-bar { background:var(--color-neutral-cloud); border-block:1px solid var(--panel-border); }
  .signal-inner { display:grid; gap:1rem; padding-block:1.4rem; align-items:center; }
  .signal-inner>p{font-weight:800;color:var(--foreground)}.signal-inner ul{display:flex;flex-wrap:wrap;gap:.7rem 1.7rem;list-style:none;padding:0;color:var(--muted)}.signal-inner li::before{content:'●';color:var(--color-cycle-capability);font-size:.55rem;margin-right:.7rem}
  .section-block { padding-block:clamp(6rem,11vw,10rem); }
  .section-intro { max-width:48rem; }.section-intro h2,.section-heading h2,.dark-panel h2{font-size:clamp(2.6rem,5vw,4.7rem);letter-spacing:-.04em}.section-intro>p:last-child{font-size:1.2rem;max-width:42rem;margin-top:1.5rem}
  .service-grid { display:grid; list-style:none; padding:0; margin-top:4rem; border-top:1px solid var(--panel-border); }
  .service-grid li{padding:2rem 0;border-bottom:1px solid var(--panel-border)}.service-grid span{color:var(--color-cycle-capability);font:800 .75rem var(--font-code)}.service-grid h3{font-size:1.6rem;margin:.8rem 0}.service-grid p{max-width:33ch;color:var(--muted)}
  .dark-panel { background:var(--color-neutral-graphite); color:#cbd5e1; padding-block:clamp(6rem,10vw,9rem); position:relative; overflow:hidden; }.dark-panel::after{content:'';position:absolute;width:28rem;height:28rem;border:5rem solid rgba(16,185,129,.09);border-radius:50%;right:-9rem;top:-12rem}.dark-panel h2{color:#fff;max-width:10ch}.eyebrow.light{color:#93c5fd}.dark-grid{display:grid;gap:3rem}.dark-copy{display:grid;gap:1.5rem;font-size:1.18rem;max-width:36rem;position:relative;z-index:1}.dark-copy a,.section-heading>a{display:inline-flex;gap:.5rem;align-items:center;width:max-content;font-weight:800;text-decoration:none}.dark-copy a{color:#fff;border-bottom:2px solid var(--color-cycle-capability);padding-bottom:.35rem}
  .section-heading{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:3rem}.section-heading>a{color:var(--foreground)}.work-grid{display:grid;list-style:none;padding:0;gap:1.5rem}
  @media(min-width:50em){.hero-shell{grid-template-columns:1.02fr .98fr}.signal-inner{grid-template-columns:auto 1fr;gap:3rem}.service-grid{grid-template-columns:repeat(3,1fr)}.service-grid li{padding:2rem;border-right:1px solid var(--panel-border)}.service-grid li:first-child{padding-left:0}.service-grid li:last-child{border-right:0}.dark-grid{grid-template-columns:1fr 1fr;gap:7rem}.work-grid{grid-template-columns:repeat(3,1fr)}.work-grid li:nth-child(2){transform:translateY(2rem)}}
  @media(max-width:36em){.hero-system{min-height:24rem}.hero-system img{width:9rem}.system-card{padding:.55rem .65rem}.card-capability{left:52%}}
</style>
