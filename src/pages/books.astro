---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import Icon from '../components/Icon.astro';
import beyondApiEconomyCover from '../assets/book-covers/Beyond-the-API-economy-cover.png';

const pageTitle = 'Beyond the API Economy | Osaango';
const pageDescription =
  'Preview Beyond the API Economy by Marjukka Niinioja, a practical field guide to productizing digital capabilities with APIOps Cycles.';
const siteUrl = Astro.site?.href ?? 'https://www.osaango.com/';
const bookCoverUrl = new URL(beyondApiEconomyCover.src, siteUrl).toString();

const bookStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: 'Beyond the API Economy',
    alternateName: 'Beyond the API Economy: Productizing Digital Capabilities with APIOps Cycles',
    author: {
      '@type': 'Person',
      name: 'Marjukka Niinioja',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Osaango',
      url: 'https://www.osaango.com/',
    },
    image: bookCoverUrl,
    description: pageDescription,
    bookFormat: ['https://schema.org/EBook', 'https://schema.org/Paperback'],
    offers: [
      {
        '@type': 'Offer',
        availability: 'https://schema.org/InStock',
        url: 'https://www.osaango.academy/products/digital_downloads/beyond-api-economy',
        itemOffered: {
          '@type': 'Book',
          bookFormat: 'https://schema.org/EBook',
        },
      },
      {
        '@type': 'Offer',
        availability: 'https://schema.org/InStock',
        url: 'https://books.apple.com/us/book/beyond-api-economy-productizing-digital-capabilities/id6800067843',
        itemOffered: {
          '@type': 'Book',
          bookFormat: 'https://schema.org/EBook',
        },
      },
      {
        '@type': 'Offer',
        availability: 'https://schema.org/InStock',
        url: 'https://www.shroffpublishers.com/books/9789368081685/',
        itemOffered: {
          '@type': 'Book',
          bookFormat: 'https://schema.org/Paperback',
        },
      },
      {
        '@type': 'Offer',
        availability: 'https://schema.org/InStock',
        url: 'https://kirjakauppa.bod.fi/beyond-the-api-economy-marjukka-niinioja-9789528089179',
        itemOffered: {
          '@type': 'Book',
          bookFormat: 'https://schema.org/Paperback',
        },
      },
    ],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={beyondApiEconomyCover}
  structuredData={bookStructuredData}
>
  <main>
    <section class="wrapper books-hero">
      <img
        class="book-cover"
        src={beyondApiEconomyCover.src}
        width={beyondApiEconomyCover.width}
        height={beyondApiEconomyCover.height}
        alt="Beyond the API Economy book cover"
      />
      <div class="book-copy">
        <p class="eyebrow"><span></span> Book</p>
        <h1>Beyond the API Economy</h1>
        <p>What if the API, integration or AI solution is not the right place to start?</p>
        <p><em>Beyond the API Economy</em> looks at digital change through the capabilities that people and organisations need. It explores how those capabilities can be productized and how APIs, integrations, automation and other means can be used to provide and consume them.</p>
        <p>The book also introduces the four current APIOps Cycles and the thinking behind the method.</p>
        <div class="actions">
          <CallToAction href="/assets/files/Beyond-the-API-Economy-final_global_v4_preview.pdf">Preview the book <Icon icon="arrow-right" /></CallToAction>
          <CallToAction href="/events/fixing-api-delivery-at-scale-apiops-cycles/" variant="secondary">Explore APIOps Cycles</CallToAction>
        </div>
        <div class="availability" aria-labelledby="availability-title">
          <h2 id="availability-title">Available as e-book, paperback and from libraries</h2>
          <p>
            Get the e-book from
            <a href="https://www.osaango.academy/products/digital_downloads/beyond-api-economy">Osaango Academy</a>,
            <a href="https://books.apple.com/us/book/beyond-api-economy-productizing-digital-capabilities/id6800067843">Apple Books</a>
            and other e-book sellers.
          </p>
          <p>
            Order the paperback from
            <a href="https://www.shroffpublishers.com/books/9789368081685/">Shroff Publishers</a>
            for the Indian subcontinent, or from
            <a href="https://kirjakauppa.bod.fi/beyond-the-api-economy-marjukka-niinioja-9789528089179">BoD</a>
            for Finland and Europe.
          </p>
          <p>For bulk orders, or orders elsewhere, <a href="#contact">contact us at Osaango</a>.</p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .books-hero {
    display: grid;
    gap: 3rem;
    align-items: center;
    min-height: clamp(36rem, 70vh, 48rem);
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .book-cover {
    width: min(100%, 23rem);
    justify-self: center;
    border-radius: .55rem;
    box-shadow: var(--shadow-lg);
  }

  .book-copy {
    display: grid;
    gap: 1.5rem;
    max-width: 42rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: .7rem;
    color: var(--apiops-accent-community);
    font-size: .76rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .eyebrow span {
    width: 2rem;
    height: 3px;
    background: var(--color-cycle-capability);
  }

  h1 {
    font-size: clamp(3rem, 7vw, 6rem) !important;
    letter-spacing: -.055em;
  }

  .book-copy p {
    color: var(--muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem;
  }

  .availability {
    display: grid;
    gap: .75rem;
    padding-block-start: .5rem;
  }

  .availability h2 {
    max-width: 34rem;
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.12;
  }

  .availability p {
    font-size: var(--text-base);
  }

  .availability a {
    color: var(--accent-regular);
    font-weight: 700;
  }

  @media (min-width: 50em) {
    .books-hero {
      grid-template-columns: minmax(18rem, .75fr) 1fr;
      gap: 5rem;
    }
  }
</style>
