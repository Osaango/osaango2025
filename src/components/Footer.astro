<style>
        footer {
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
                margin-top: auto;
                padding: 3rem 2rem 3rem;
                text-align: center;
                color: var(--gray-400);
                font-size: var(--text-sm);
                background: var(--color-neutral-graphite);
                color: #cbd5e1;
                text-align: left;
        }

        .footer-brand { display: grid; gap: .5rem; max-width: 38rem; }
        .footer-brand strong { color: white; font: 600 clamp(1.8rem, 4vw, 3.2rem)/1 var(--font-display); }
        .footer-brand p { font-size: var(--text-md); }
        footer a { color: white; }

        .columns {
                display: grid;
                gap: 1.5rem;
        }

        footer p {
                margin: 0;
        }

        .copyright {
                text-align: center;
        }

        @media (min-width: 40em) {
                .columns {
                        grid-template-columns: repeat(2, 1fr);
                        text-align: left;
                }
        }

        @media (min-width: 64em) {
                .columns {
                        grid-template-columns: repeat(4, 1fr);
                }
        }

        @media (min-width: 50em) {
                footer {
                        padding: 2.5rem 5rem;
                }
        }
</style>
