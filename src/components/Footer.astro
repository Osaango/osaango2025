---
const footerLinks = [
        { label: 'How we help', href: '/how-we-help/' },
        { label: 'Work', href: '/work/' },
        { label: 'Speaking', href: '/speaking/' },
        { label: 'Books', href: '/books/' },
        { label: 'APIOps diagnostic', href: '/connect/' },
        { label: 'Blog', href: '/blog/' },
        { label: 'About', href: '/about/' },
];
---

<footer id="contact">
        <div class="footer-inner">
                <div class="footer-brand">
                        <strong>Make change flow.</strong>
                        <p>Strategy, architecture and ways of working for organisations navigating difficult digital change.</p>
                </div>
                <nav class="footer-nav" aria-label="Footer navigation">
                        <ul>
                                {
                                        footerLinks.map((link) => (
                                                <li><a href={link.href}>{link.label}</a></li>
                                        ))
                                }
                        </ul>
                </nav>
                <div class="columns">
                        <div>Osaango Oy is a private limited company registered in Finland.</div>
                        <div>
                                Osaango Oy,<br />
                                PO Box 10<br />
                                11101 Riihimäki, Finland
                        </div>
                        <div>
                                info@osaango.com<br />
                        </div>
                        <div>
                                Trade register: 2881365-2<br />
                                VAT registration: FI28813652<br />
                                DUNS: 368558872
                        </div>
                </div>
                <p class="copyright">&copy; 2026 Osaango. All rights reserved. <a href="/privacy-policy/">Privacy</a></p>
        </div>
</footer>

<style>
        footer {
                margin-top: auto;
                background: var(--color-neutral-graphite);
                color: #cbd5e1;
                font-size: var(--text-sm);
                text-align: left;
        }

        .footer-inner {
                display: grid;
                gap: 2.5rem;
                width: 100%;
                max-width: 83rem;
                margin-inline: auto;
                padding: clamp(3rem, 6vw, 5rem) 1.5rem;
        }

        .footer-brand {
                display: grid;
                gap: .5rem;
                max-width: 38rem;
        }

        .footer-brand strong {
                color: white;
                font: 600 clamp(1.8rem, 4vw, 3.2rem)/1 var(--font-display);
        }

        .footer-brand p {
                font-size: var(--text-md);
        }

        footer a {
                color: white;
        }

        .footer-nav ul {
                display: flex;
                flex-wrap: wrap;
                gap: .7rem 1.4rem;
                padding: 0;
                list-style: none;
        }

        .footer-nav a {
                color: #e2e8f0;
                font-family: var(--font-brand);
                font-weight: 600;
                text-decoration: none;
        }

        .footer-nav a:hover,
        .footer-nav a:focus {
                color: white;
                text-decoration: underline;
                text-decoration-thickness: 1px;
                text-underline-offset: .25em;
        }

        .columns {
                display: grid;
                gap: 1.5rem;
        }

        footer p {
                margin: 0;
        }

        .copyright {
                text-align: center;
        }

        @media (min-width: 40em) {
                .columns {
                        grid-template-columns: repeat(2, 1fr);
                }
        }

        @media (min-width: 64em) {
                .columns {
                        grid-template-columns: repeat(4, 1fr);
                }
        }
</style>
