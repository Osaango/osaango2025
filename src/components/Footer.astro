<style>
        footer {
                margin-top: auto;
                background: var(--color-neutral-graphite);
                color: #cbd5e1;
                font-size: var(--text-sm);
                text-align: left;
        }

        .footer-inner {
                display: grid;
                gap: 2.5rem;
                width: 100%;
                max-width: 83rem;
                margin-inline: auto;
                padding: clamp(3rem, 6vw, 5rem) 1.5rem;
        }

        .footer-brand {
                display: grid;
                gap: .5rem;
                max-width: 38rem;
        }

        .footer-brand strong {
                color: white;
                font: 600 clamp(1.8rem, 4vw, 3.2rem)/1 var(--font-display);
        }

        .footer-brand p {
                font-size: var(--text-md);
        }

        footer a {
                color: white;
        }

        .columns {
                display: grid;
                gap: 1.5rem;
        }

        footer p {
                margin: 0;
        }

        .copyright {
                text-align: center;
        }

        @media (min-width: 40em) {
                .columns {
                        grid-template-columns: repeat(2, 1fr);
                }
        }

        @media (min-width: 64em) {
                .columns {
                        grid-template-columns: repeat(4, 1fr);
                }
        }
</style>
