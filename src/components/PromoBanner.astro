---
import type { PromotionBanner } from '../config/ads';
import Icon from './Icon.astro';

interface Props {
  banner?: PromotionBanner;
}

const { banner } = Astro.props as Props;
---

{
  banner && (
    <aside class="promo-banner" aria-label="Promotion">
      <a class="promo-banner__link wrapper" href={banner.linkHref}>
        {banner.imageSrc && (
          <img
            class="promo-banner__image"
            src={banner.imageSrc}
            alt={banner.imageAlt ?? ''}
            loading="lazy"
            decoding="async"
          />
        )}
        <div class="promo-banner__content">
          <p class="promo-banner__title">{banner.title}</p>
          {banner.description && <p class="promo-banner__description">{banner.description}</p>}
        </div>
        <span class="promo-banner__cta">{banner.linkLabel ?? 'Read more'} <Icon icon="arrow-right" /></span>
      </a>
    </aside>
  )
}

<style>
  .promo-banner {
    position: relative;
    color: #fff;
    background:
      radial-gradient(circle at 18% 50%, rgba(255,255,255,.18), transparent 32%),
      linear-gradient(135deg, #174ee6, #8a2be2);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--color-neutral-graphite) 14%, transparent);
  }

  .promo-banner__link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1rem;
    color: inherit;
    text-decoration: none;
    padding-block: 0.8rem;
  }

  .promo-banner__image {
    width: 100%;
    max-height: 50px;
    object-fit: cover;
    border-radius: 0.5rem;
    border: 1px solid rgba(255,255,255,.2);
    box-shadow: 0 8px 18px rgba(0,0,0,.22);
  }

  .promo-banner__content {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    text-align: center;
  }

  .promo-banner__title {
    color: inherit;
    font-size: var(--text-base);
    font-weight: 800;
    line-height: 1.25;
  }

  .promo-banner__description {
    color: inherit;
    font-size: var(--text-sm);
    opacity: 0.9;
  }

  .promo-banner__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: var(--control-min-height);
    padding: 0.45rem 0.75rem;
    border: 1px solid rgba(255,255,255,.5);
    border-radius: var(--control-radius);
    background: rgba(0,0,0,.18);
    color: inherit;
    font-size: var(--text-sm);
    font-weight: 800;
    transition:
      background-color var(--theme-transition),
      border-color var(--theme-transition);
  }

  .promo-banner__cta :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .promo-banner__link:hover .promo-banner__cta,
  .promo-banner__link:focus-visible .promo-banner__cta {
    background: rgba(0,0,0,.28);
    border-color: rgba(255,255,255,.75);
  }

  @media (min-width: 50em) {
    .promo-banner__link {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 1rem;
      padding-block: 0.65rem;
    }

    .promo-banner__image {
      width: 9rem;
      max-height: 4rem;
      margin-right: 0.25rem;
    }

    .promo-banner__description,
    .promo-banner__cta {
      font-size: var(--text-base);
    }
  }
</style>
